        for s in items:
            freq = float(s.get('frequency', s.get('freq', 0)))
            # L'API DXSummit renvoie la fréquence en kHz (ex: 144260.1) — nos
            # bandes VHF/UHF sont toujours < 1000 en MHz, donc toute valeur
            # au-dessus indique du kHz non converti.
