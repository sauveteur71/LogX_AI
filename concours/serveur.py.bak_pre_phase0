        if my_ll[0] and dx_ll and dx_ll[0]:
            bearing_deg = bearing(my_ll[0], my_ll[1], dx_ll[0], dx_ll[1])
        card = cardinal(bearing_deg)
        lines.append(f"""
{'='*55}
#{i+1} — {s.get('call','?')} | {s.get('band','?')} MHz | {s.get('locator','?')}
📏 Distance : {s.get('dist_km',0)} km depuis {my_locator}
