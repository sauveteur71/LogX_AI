<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>RadioContest AI — Logbook Multi-Opérateur</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Exo+2:wght@300;400;600;800&display=swap');
:root {
  --bg:#07080F;--bg2:#0D0E1A;--bg3:#13152A;--border:#1E2040;
  --accent:#FF6B00;--accent2:#00D4FF;--green:#00FF88;--red:#FF2D55;
  --yellow:#FFD60A;--purple:#BF5AF2;--text:#E0E4FF;--muted:#4A5080;
  --font-mono:'Share Tech Mono',monospace;--font:'Exo 2',sans-serif;
}
*{box-sizing:border-box;margin:0;padding:0}
body{background:var(--bg);color:var(--text);font-family:var(--font);min-height:100vh;display:flex;flex-direction:column}

/* HEADER */
header{background:linear-gradient(90deg,#0A0B18,#131530,#0A0B18);border-bottom:2px solid var(--border);padding:10px 20px;display:flex;align-items:center;justify-content:space-between;flex-shrink:0}
.logo{font-family:var(--font-mono);font-size:18px;color:var(--accent);letter-spacing:3px}
.logo span{color:var(--accent2)}
.hdr-info{display:flex;align-items:center;gap:20px}
.live-dot{width:8px;height:8px;border-radius:50%;background:var(--green);box-shadow:0 0 10px var(--green);animation:pulse 2s infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}
.clock{font-family:var(--font-mono);font-size:13px;color:var(--muted)}
.contest-info{font-family:var(--font-mono);font-size:11px;color:var(--accent2);letter-spacing:1px}

/* SCORE BANNER */
.score-banner{display:flex;background:var(--bg2);border-bottom:1px solid var(--border);flex-shrink:0}
.sb-item{flex:1;padding:8px 16px;border-right:1px solid var(--border);text-align:center}
.sb-item:last-child{border-right:none}
.sb-lbl{font-size:9px;color:var(--muted);letter-spacing:2px;font-family:var(--font-mono)}
.sb-val{font-size:18px;font-weight:800;font-family:var(--font-mono)}

/* MAIN LAYOUT */
.main{display:flex;flex:1;overflow:hidden;height:calc(100vh - 100px)}

/* SAISIE */
.saisie-panel{width:380px;flex-shrink:0;background:var(--bg2);border-right:2px solid var(--border);display:flex;flex-direction:column;overflow-y:auto}
.panel-title{font-family:var(--font-mono);font-size:11px;color:var(--accent2);letter-spacing:3px;padding:14px 16px 8px;border-bottom:1px solid var(--border)}

/* FORM DE SAISIE */
.saisie-form{padding:16px;display:flex;flex-direction:column;gap:10px}
.op-select{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:4px}
.op-btn{font-family:var(--font-mono);font-size:10px;padding:5px 10px;border-radius:5px;border:1px solid var(--border);background:var(--bg3);color:var(--muted);cursor:pointer;transition:all .15s;letter-spacing:1px}
.op-btn.active{border-color:var(--accent);color:var(--accent);background:rgba(255,107,0,.1)}

.field-group{display:flex;flex-direction:column;gap:4px}
.field-label{font-size:9px;color:var(--muted);letter-spacing:2px;font-family:var(--font-mono)}
.field-input{background:var(--bg3);border:1px solid var(--border);border-radius:6px;color:var(--text);font-family:var(--font-mono);font-size:16px;padding:10px 12px;outline:none;transition:border-color .2s;width:100%;text-transform:uppercase;letter-spacing:2px}
.field-input:focus{border-color:var(--accent2);box-shadow:0 0 10px rgba(0,212,255,.15)}
.field-input.error{border-color:var(--red)}
.field-input.ok{border-color:var(--green)}

.field-row{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.field-row-3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:6px}

/* RS FIELD */
.rs-field{background:var(--bg3);border:1px solid var(--border);border-radius:6px;color:var(--yellow);font-family:var(--font-mono);font-size:18px;padding:10px 12px;outline:none;width:100%;text-align:center;font-weight:700}
.rs-field:focus{border-color:var(--yellow)}

/* LOCATOR HINT */
.loc-hint{font-family:var(--font-mono);font-size:10px;color:var(--green);padding:4px 8px;background:rgba(0,255,136,.05);border-radius:4px;border:1px solid rgba(0,255,136,.2);display:none}

/* SUBMIT BTN */
.submit-btn{background:linear-gradient(135deg,var(--green),#00D4FF);border:none;border-radius:8px;color:#0A0B18;font-family:var(--font-mono);font-size:14px;font-weight:700;padding:14px;cursor:pointer;letter-spacing:3px;transition:all .15s;margin-top:4px}
.submit-btn:hover{opacity:.85;transform:translateY(-1px);box-shadow:0 6px 20px rgba(0,255,136,.3)}
.submit-btn:active{transform:translateY(0)}
.submit-btn:disabled{opacity:.4;cursor:not-allowed;transform:none}

/* DUPLEX CHECK */
.dup-warning{background:rgba(255,45,85,.1);border:1px solid var(--red);border-radius:6px;padding:8px 12px;font-family:var(--font-mono);font-size:11px;color:var(--red);display:none}
.dup-warning.show{display:block}

/* BANDE / MODE */
.band-mode-row{display:flex;gap:6px;flex-wrap:wrap}
.bm-btn{font-family:var(--font-mono);font-size:10px;padding:6px 10px;border-radius:5px;border:1px solid var(--border);background:var(--bg3);color:var(--muted);cursor:pointer;transition:all .15s}
.bm-btn.active{border-color:var(--accent2);color:var(--accent2);background:rgba(0,212,255,.1)}

/* DERNIERS QSO */
.last-qso{padding:10px 16px;border-top:1px solid var(--border)}
.last-qso-title{font-family:var(--font-mono);font-size:9px;color:var(--muted);letter-spacing:2px;margin-bottom:8px}
.last-qso-item{display:flex;align-items:center;gap:8px;padding:5px 8px;border-radius:5px;background:var(--bg3);margin-bottom:4px;font-family:var(--font-mono);font-size:11px;border-left:3px solid var(--green)}
.lqi-call{color:var(--green);font-weight:700;min-width:80px}
.lqi-loc{color:var(--accent2);min-width:50px}
.lqi-pts{color:var(--yellow);min-width:40px;text-align:right}
.lqi-op{color:var(--muted);font-size:9px}

/* LOG TABLE */
.log-panel{flex:1;display:flex;flex-direction:column;overflow:hidden}
.log-toolbar{padding:10px 16px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:10px;background:var(--bg2);flex-shrink:0}
.log-search{background:var(--bg3);border:1px solid var(--border);border-radius:6px;color:var(--text);font-family:var(--font-mono);font-size:12px;padding:7px 12px;outline:none;width:200px}
.log-search:focus{border-color:var(--accent2)}
.filter-btn{font-family:var(--font-mono);font-size:10px;padding:6px 10px;border-radius:5px;border:1px solid var(--border);background:var(--bg3);color:var(--muted);cursor:pointer;transition:all .15s;letter-spacing:1px}
.filter-btn.active{border-color:var(--accent2);color:var(--accent2)}
.log-count{font-family:var(--font-mono);font-size:10px;color:var(--muted);margin-left:auto}
.export-btn{font-family:var(--font-mono);font-size:10px;padding:6px 12px;border-radius:5px;border:1px solid var(--border);background:var(--bg3);color:var(--accent);cursor:pointer;transition:all .15s}
.export-btn:hover{border-color:var(--accent)}

.log-table-wrap{flex:1;overflow-y:auto}
.log-table-wrap::-webkit-scrollbar{width:4px}
.log-table-wrap::-webkit-scrollbar-thumb{background:var(--border);border-radius:2px}

table{width:100%;border-collapse:collapse;font-family:var(--font-mono);font-size:15px}
thead{position:sticky;top:0;z-index:10;background:#0A0C20}
th{padding:10px 12px;text-align:left;color:#8899CC;font-size:11px;letter-spacing:2px;border-bottom:2px solid #2A3080;white-space:nowrap;font-weight:700}
td{padding:10px 12px;border-bottom:1px solid #141630;white-space:nowrap;vertical-align:middle;font-size:15px}
tr:hover td{background:#101828;cursor:pointer}
tr.new-entry td{animation:highlight 1.2s ease}
@keyframes highlight{from{background:rgba(0,255,136,.25)}to{background:transparent}}
tr.dup-entry td{opacity:.45;text-decoration:line-through}

.td-num{color:#4A6090;font-size:12px;width:36px;text-align:center}
.td-time{color:#6080B0;font-size:14px;letter-spacing:1px}
.td-call{color:#00FF88;font-weight:800;font-size:18px;letter-spacing:2px}
.td-band{color:#00D4FF;font-size:13px;font-weight:700}
.td-mode{color:#E0A0FF;font-size:13px;font-weight:700}
.td-sent{color:#FFFFFF;font-size:15px;font-weight:600}
.td-rcvd{color:#C0D0FF;font-size:15px}
.td-loc{color:#40C8FF;font-size:15px;letter-spacing:1px;font-weight:700}
.td-pts{color:#FFD60A;font-weight:800;font-size:16px;text-align:right}
.td-op{font-size:12px;padding:3px 8px;border-radius:4px;font-weight:800;letter-spacing:1px}
.td-edit{color:#4A5080;cursor:pointer;font-size:16px;padding:0 4px;transition:color .15s}
.td-edit:hover{color:#00D4FF}
.td-del{color:#4A5080;cursor:pointer;font-size:16px;padding:0 4px;transition:color .15s}
.td-del:hover{color:#FF2D55}

/* OP COLORS */
.op-1{background:rgba(255,107,0,.3);color:#FF8030;border:1px solid rgba(255,107,0,.4)}
.op-2{background:rgba(0,212,255,.3);color:#00E8FF;border:1px solid rgba(0,212,255,.4)}
.op-3{background:rgba(191,90,242,.3);color:#D080FF;border:1px solid rgba(191,90,242,.4)}
.op-4{background:rgba(255,214,10,.3);color:#FFE040;border:1px solid rgba(255,214,10,.4)}
.op-5{background:rgba(0,255,136,.3);color:#00FF88;border:1px solid rgba(0,255,136,.4)}

/* AUTOCOMPLETE */
.autocomplete-box{position:absolute;background:#0D1828;border:1px solid #00D4FF;border-radius:8px;z-index:200;width:100%;max-height:220px;overflow-y:auto;box-shadow:0 8px 24px rgba(0,0,0,.6);top:100%;left:0;margin-top:3px}
.autocomplete-box::-webkit-scrollbar{width:3px}
.autocomplete-box::-webkit-scrollbar-thumb{background:#1E3060;border-radius:2px}
.ac-item{display:flex;align-items:center;gap:10px;padding:9px 14px;cursor:pointer;transition:background .1s;border-bottom:1px solid #101828;font-family:var(--font-mono)}
.ac-item:hover,.ac-item.selected{background:#102040}
.ac-item:last-child{border-bottom:none}
.ac-call{color:#00FF88;font-size:16px;font-weight:800;min-width:110px;letter-spacing:1px}
.ac-dept{color:#FFD60A;font-size:12px;min-width:60px}
.ac-dept-name{color:#8899CC;font-size:11px;flex:1}
.ac-loc{color:#40C8FF;font-size:13px;font-weight:700;letter-spacing:1px}
.ac-match{background:#002040;border-radius:3px;padding:0 2px}
.field-wrap{position:relative}
.edit-overlay{position:fixed;inset:0;background:rgba(7,8,15,.92);display:flex;align-items:center;justify-content:center;z-index:500;display:none}
.edit-overlay.show{display:flex}
.edit-box{background:#0D0E1A;border:2px solid #00D4FF;border-radius:14px;padding:24px;width:520px;box-shadow:0 0 40px rgba(0,212,255,.2)}
.edit-title{font-family:var(--font-mono);font-size:13px;color:#00D4FF;letter-spacing:3px;margin-bottom:16px;display:flex;justify-content:space-between;align-items:center}
.edit-close{cursor:pointer;color:#4A5080;font-size:20px;transition:color .15s}
.edit-close:hover{color:#FF2D55}
.edit-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;margin-bottom:14px}
.edit-field{display:flex;flex-direction:column;gap:4px}
.edit-lbl{font-size:10px;color:#4A6090;letter-spacing:2px;font-family:var(--font-mono)}
.edit-input{background:#13152A;border:1px solid #1E2040;border-radius:6px;color:#E0E4FF;font-family:var(--font-mono);font-size:15px;padding:9px 11px;outline:none;width:100%;text-transform:uppercase;transition:border-color .2s}
.edit-input:focus{border-color:#00D4FF}
.edit-input.big{font-size:18px;font-weight:700;color:#00FF88;letter-spacing:2px}
.edit-btn-row{display:flex;gap:8px;justify-content:flex-end}
.edit-save{background:linear-gradient(135deg,#00FF88,#00D4FF);border:none;border-radius:7px;color:#0A0B18;font-family:var(--font-mono);font-size:13px;font-weight:800;padding:11px 24px;cursor:pointer;letter-spacing:2px;transition:opacity .15s}
.edit-save:hover{opacity:.85}
.edit-cancel{background:#13152A;border:1px solid #1E2040;border-radius:7px;color:#4A5080;font-family:var(--font-mono);font-size:13px;padding:11px 20px;cursor:pointer;transition:all .15s}
.edit-cancel:hover{border-color:#FF2D55;color:#FF2D55}

/* CONNEXION RÉSEAU */
.net-status{display:flex;align-items:center;gap:6px;font-family:var(--font-mono);font-size:10px;color:var(--muted);padding:6px 16px;background:var(--bg);border-bottom:1px solid var(--border)}
.net-dot{width:6px;height:6px;border-radius:50%}
.net-dot.online{background:var(--green)}
.net-dot.offline{background:var(--red)}
.net-peers{color:var(--accent2)}

/* MODAL */
.modal-overlay{position:fixed;inset:0;background:rgba(7,8,15,.95);display:flex;align-items:center;justify-content:center;z-index:1000}
.modal{background:var(--bg2);border:1px solid var(--border);border-radius:14px;padding:28px;width:440px;box-shadow:0 0 60px rgba(0,212,255,.1)}
.modal h2{font-family:var(--font-mono);color:var(--accent2);letter-spacing:3px;margin-bottom:10px;font-size:15px}
.modal p{color:var(--muted);font-size:13px;margin-bottom:16px;line-height:1.6}
.modal input,.modal select{width:100%;background:var(--bg3);border:1px solid var(--border);border-radius:7px;color:var(--text);font-family:var(--font-mono);font-size:13px;padding:10px 13px;outline:none;margin-bottom:10px}
.modal input:focus,.modal select:focus{border-color:var(--accent2)}
.modal-btn{width:100%;background:linear-gradient(135deg,var(--accent2),#0080FF);border:none;border-radius:8px;color:#fff;font-family:var(--font-mono);font-size:13px;letter-spacing:2px;padding:12px;cursor:pointer;font-weight:600}
.nav-links{display:flex;gap:8px;padding:6px 16px;background:var(--bg);border-bottom:1px solid var(--border)}
.nav-link{font-family:var(--font-mono);font-size:10px;color:var(--muted);text-decoration:none;padding:4px 10px;border-radius:4px;border:1px solid var(--border);transition:all .15s;letter-spacing:1px}
.nav-link:hover,.nav-link.active{border-color:var(--accent2);color:var(--accent2)}
</style>
</head>
<body>

<!-- MODAL ÉDITION QSO -->
<div class="edit-overlay" id="editOverlay">
  <div class="edit-box">
    <div class="edit-title">
      <span>✏️ CORRIGER LE QSO</span>
      <span class="edit-close" onclick="closeEdit()">✕</span>
    </div>
    <input type="hidden" id="editId">
    <div class="edit-grid">
      <div class="edit-field" style="grid-column:1/-1">
        <div class="edit-lbl">INDICATIF</div>
        <input type="text" class="edit-input big" id="editCall" placeholder="F5XYZ">
      </div>
      <div class="edit-field">
        <div class="edit-lbl">RST ENVOYÉ</div>
        <input type="text" class="edit-input" id="editRSTsent" style="color:#FFD60A;font-size:18px;text-align:center">
      </div>
      <div class="edit-field">
        <div class="edit-lbl">N° ENVOYÉ</div>
        <input type="text" class="edit-input" id="editNumSent" style="color:#FF6B00;font-size:18px;text-align:center">
      </div>
      <div class="edit-field">
        <div class="edit-lbl">BANDE MHz</div>
        <input type="text" class="edit-input" id="editBand" style="color:#00D4FF;font-size:18px;text-align:center">
      </div>
      <div class="edit-field">
        <div class="edit-lbl">RST REÇU</div>
        <input type="text" class="edit-input" id="editRSTrcvd" style="color:#C0D0FF;font-size:18px;text-align:center">
      </div>
      <div class="edit-field">
        <div class="edit-lbl">N° REÇU</div>
        <input type="text" class="edit-input" id="editNumRcvd" style="color:#C0D0FF;font-size:18px;text-align:center">
      </div>
      <div class="edit-field">
        <div class="edit-lbl">MODE</div>
        <input type="text" class="edit-input" id="editMode" style="color:#E0A0FF;font-size:18px;text-align:center">
      </div>
      <div class="edit-field" style="grid-column:1/-1">
        <div class="edit-lbl">LOCATOR CORRESPONDANT</div>
        <input type="text" class="edit-input" id="editLocator" placeholder="JN03QQ" style="color:#40C8FF;font-size:18px;letter-spacing:3px">
      </div>
    </div>
    <div id="editDistInfo" style="font-family:var(--font-mono);font-size:12px;color:#00FF88;margin-bottom:14px;padding:8px 12px;background:rgba(0,255,136,.05);border-radius:6px;border:1px solid rgba(0,255,136,.2);display:none"></div>
    <div class="edit-btn-row">
      <button class="edit-cancel" onclick="closeEdit()">ANNULER</button>
      <button class="edit-save" onclick="saveEdit()">✅ SAUVEGARDER</button>
    </div>
  </div>
</div>

<!-- MODAL CONFIG -->
<div class="modal-overlay" id="setupModal">
  <div class="modal">
    <h2>⚡ LOGBOOK MULTI-OP</h2>
    <p>Configure ton poste avant de commencer la saisie.</p>
    <input type="text" id="setupCallsign" placeholder="F6KQJ/P" value="F6KQJ/P" style="text-transform:uppercase;font-size:16px;font-weight:700;color:var(--accent)">
    <input type="text" id="setupLocator" placeholder="JN15XC" value="JN15XC" style="text-transform:uppercase">
    <select id="setupOperator">
      <option value="">-- Sélectionne ton identifiant opérateur --</option>
      <option value="OP1">OP1 — Opérateur 1</option>
      <option value="OP2">OP2 — Opérateur 2</option>
      <option value="OP3">OP3 — Opérateur 3</option>
      <option value="OP4">OP4 — Opérateur 4</option>
      <option value="OP5">OP5 — Opérateur 5</option>
    </select>
    <select id="setupContest">
      <option value="REF_RPH">Rallye des Points Hauts REF</option>
      <option value="REF_NAT_THF">National THF REF</option>
      <option value="REF_PRINTEMPS">Concours du Printemps REF</option>
      <option value="REF_ETE">Concours d'Été REF</option>
      <option value="REF_CDF_THF">Championnat de France THF</option>
      <option value="REF_IARU_VHF">IARU R1 VHF</option>
      <option value="REF_IARU_UHF">IARU UHF/SHF</option>
      <option value="REF_CCD">Courte Durée Cumulatif</option>
      <option value="CQ_WW_SSB">CQ WW SSB</option>
      <option value="CQ_WW_CW">CQ WW CW</option>
      <option value="CUSTOM">Concours personnalisé</option>
    </select>
    <button class="modal-btn" onclick="setupDone()">DÉMARRER LA SAISIE ▶</button>
  </div>
</div>

<!-- HEADER -->
<header>
  <div>
    <div class="logo">Radio<span>Contest</span> AI — <span id="hdrContest" style="color:var(--yellow)">LOGBOOK</span></div>
  </div>
  <div class="hdr-info">
    <div class="live-dot"></div>
    <div class="contest-info" id="hdrStation">—</div>
    <div class="clock" id="clock">00:00:00 UTC</div>
  </div>
</header>

<!-- NAV -->
<div class="nav-links">
  <a href="radiocontest.html" class="nav-link">🗺️ CARTE IA</a>
  <a href="logbook.html" class="nav-link active">📋 LOGBOOK</a>
  <a href="configuration.html" class="nav-link">⚙ CONFIG</a>
  <span style="margin-left:auto;font-family:var(--font-mono);font-size:10px;color:var(--muted)">
    Opérateur actif : <span id="currentOp" style="color:var(--accent)">—</span>
  </span>
</div>

<!-- RÉSEAU -->
<div class="net-status">
  <div class="net-dot" id="netDot"></div>
  <span id="netStatus">Connexion au serveur...</span>
  <span style="margin-left:12px">Postes connectés : <span class="net-peers" id="netPeers">—</span></span>
  <span style="margin-left:12px;color:var(--muted)">Serveur : <span id="serverAddr" style="color:var(--accent2)">localhost:8080</span></span>
  <span style="margin-left:auto;font-family:var(--font-mono);font-size:9px;color:var(--muted)">Partage : connecte les autres PC au même WiFi → http://<span id="localIP">TON-IP</span>:8080/logbook.html</span>
</div>

<!-- SCORE BANNER -->
<div class="score-banner">
  <div class="sb-item"><div class="sb-lbl">SCORE TOTAL</div><div class="sb-val" id="sbTotal" style="color:var(--accent)">0 pts</div></div>
  <div class="sb-item"><div class="sb-lbl">QSO 144 / 432</div><div class="sb-val" id="sbQso" style="color:var(--green)">0 / 0</div></div>
  <div class="sb-item"><div class="sb-lbl">MEILLEUR DX</div><div class="sb-val" id="sbBestDX" style="color:var(--yellow);font-size:13px">—</div></div>
  <div class="sb-item"><div class="sb-lbl">LOCATORS UNIQUES</div><div class="sb-val" id="sbMults" style="color:var(--accent2)">0</div></div>
  <div class="sb-item"><div class="sb-lbl">QSO/HEURE · PROJECTION</div><div class="sb-val" id="sbRate" style="color:var(--purple);font-size:13px">— · —</div></div>
  <div class="sb-item"><div class="sb-lbl">DOUBLONS</div><div class="sb-val" id="sbDups" style="color:var(--red)">0</div></div>
